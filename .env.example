# Copy to .env and adjust. Every value has a working default, so .env is optional.

# PostgreSQL credentials used by docker compose
POSTGRES_DB=coe
POSTGRES_USER=coe
# Must match the password the database volume was FIRST created with (the compose default
# is coe_password). Changing it here later breaks login: use ALTER USER, or a fresh volume.
POSTGRES_PASSWORD=coe_password

# Host port for the web app (http://localhost:8080)
WEB_PORT=8080

# "Wait" when the median forecast one quarter ahead is at least this far below today
WAIT_THRESHOLD=0.08

# Worker processes for the ML pipeline (parallel model fitting)
COE_WORKERS=4

# Optional: data.gov.sg API key for higher rate limits (the public API works without one)
DATAGOV_API_KEY=

# Optional: COE Analyst language model (server-side only; never sent to the browser).
# Set ONE key. GROQ_API_KEY -> Groq (default model openai/gpt-oss-120b);
# ANTHROPIC_API_KEY -> Claude (default model claude-opus-5-5). With both, Groq is used
# unless ANALYST_PROVIDER says otherwise. Without a key the analyst runs in "basic mode":
# navigation, bid maths, glossary and recommendation explanations still work.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# groq | anthropic (empty = pick from the key that is set)
ANALYST_PROVIDER=
# Empty = the provider's default. Other Groq options: llama-3.3-70b-versatile, openai/gpt-oss-20b
ANALYST_MODEL=
# low | medium | high (empty = the model's default)
ANALYST_EFFORT=
